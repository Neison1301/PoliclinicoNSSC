# ============================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Policlínico NSSC - Docker Environment
# ============================================

# ----------------
# Base de Datos MySQL
# ----------------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=policlinicosagrado
MYSQL_USER=policlinico_user
MYSQL_PASSWORD=policlinico_pass

# ----------------
# Configuración de Email
# ----------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_email@gmail.com
MAIL_PASSWORD=tu_password_app

# ----------------
# Configuración de Spring
# ----------------
SPRING_PROFILES_ACTIVE=prod

# ============================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a .env
# 2. Modifica los valores según tu configuración
# 3. NO subas el archivo .env al repositorio
# ============================================
